            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tool_name\": \"create_memory\",\n  \"proposed_input\": {\n    \"type\": \"system_note\",\n    \"title\": \"Rejected proposal smoke memory\",\n    \"content\": \"Synthetic proposal intended to be rejected.\",\n    \"source\": \"user_manual\",\n    \"confidence\": \"medium\",\n    \"importance\": \"low\",\n    \"visibility\": \"assistant_context\"\n  },\n  \"reason\": \"Manual smoke test reject path\",\n  \"risk_level\": \"low\"\n}"
