    {
      "name": "Create Activity",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"task\",\n  \"title\": \"Smoke test activity\",\n  \"description\": \"Synthetic manual smoke test activity\",\n  \"priority\": \"medium\",\n  \"due_at\": \"{{tomorrow_rfc3339}}\",\n  \"timezone\": \"America/Tijuana\",\n  \"tags\": [\"smoke\", \"v0.1\"],\n  \"has_reminder\": false,\n  \"ai_manageable\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/activities",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "activities"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('create activity returns 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.expect(json.id).to.be.a('string');",
              "pm.collectionVariables.set('activity_id', json.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List Activities",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/activities?limit=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "activities"
          ],
          "query": [
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('list activities returns 200', function () { pm.response.to.have.status(200); });",
              "pm.expect(pm.response.json().activities).to.be.an('array');"
            ]
          }
        }
      ]
    },
