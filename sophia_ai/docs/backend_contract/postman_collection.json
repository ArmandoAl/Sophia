{
  "info": {
    "name": "Sofia Backend v0.1 Smoke Tests",
    "description": "Manual smoke test collection for Sofia Backend v0.1. Uses synthetic data only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "activity_id",
      "value": ""
    },
    {
      "key": "reminder_id",
      "value": ""
    },
    {
      "key": "memory_id",
      "value": ""
    },
    {
      "key": "action_proposal_id",
      "value": ""
    },
    {
      "key": "rejected_action_proposal_id",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('smoke_email')) {",
          "  pm.collectionVariables.set('smoke_email', 'sofia.smoke.' + Date.now() + '@example.test');",
          "}",
          "pm.collectionVariables.set('smoke_password', 'SmokePass123!');",
          "pm.collectionVariables.set('now_rfc3339', new Date().toISOString());",
          "pm.collectionVariables.set('tomorrow_rfc3339', new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('health returns 200', function () { pm.response.to.have.status(200); });",
              "pm.test('health status ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Register",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sofia Smoke User\",\n  \"email\": \"{{smoke_email}}\",\n  \"password\": \"{{smoke_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('register returns 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "if (json.id) { pm.collectionVariables.set('user_id', json.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{smoke_email}}\",\n  \"password\": \"{{smoke_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login returns 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.expect(json.token).to.be.a('string');",
              "pm.collectionVariables.set('token', json.token);",
              "if (json.user && json.user.id) { pm.collectionVariables.set('user_id', json.user.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Users Me",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/users/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('users/me returns 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.expect(JSON.stringify(json)).to.include(pm.collectionVariables.get('user_id'));"
            ]
          }
        }
      ]
    },
